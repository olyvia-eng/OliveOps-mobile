{
  "name": "oliveops-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-device": "^57.0.1",
    "expo-image-picker": "~57.0.8",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:fast": "vitest run --exclude src/**/*.screen.test.tsx",
    "test:ui": "vitest run screen.test.tsx",
    "test:full": "npm run test:fast && npm run test:ui && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "ci:test": "npm run test:full"
  },
  "private": true
}
