{
  "name": "oliveops-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-community/netinfo": "11.4.1",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:fast": "vitest run --exclude src/**/*.screen.test.tsx",
    "test:ui": "vitest run screen.test.tsx",
    "test:full": "npm run test:fast && npm run test:ui && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "ci:test": "npm run test:full"
  },
  "private": true
}
