{
  "expo": {
    "name": "OliveOps",
    "slug": "oliveops-mobile",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C5F2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ca.oliveops.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ca.oliveops.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2C5F2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "OliveOps accesses your photo library only when you choose to attach a photo to a shift note.",
          "cameraPermission": "OliveOps uses your camera only when you choose to take a photo for a shift note."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "oliveops-mobile"
      }
    }
  }
}
