{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_DIAGNOSTIC_NATIVE_STARTUP": "true"
      },
      "autoIncrement": true
    },
    "diagnostic-plain-js": {
      "extends": "production",
      "env": {
        "OLIVEOPS_IOS_PLAIN_JS_BUNDLE": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
