EXPO_PUBLIC_API_BASE_URL=https://app.oliveops.ca
EXPO_PUBLIC_SENTRY_DSN=
# Temporary startup-isolation flag. Leave false for the normal OliveOps application.
EXPO_PUBLIC_DIAGNOSTIC_NATIVE_STARTUP=false
# Development-only override for physical devices.
# Leave disabled unless you intentionally need localhost behavior on device.
EXPO_PUBLIC_ALLOW_LOCALHOST_FOR_DEVICE=false
